# Ollama Proxy Configuration

# Required: API key for authentication
API_KEY=your_secret_api_key_here

# Ollama GPU server URL (default routing target for unlisted models)
# This is used for models NOT in the model-routing.json CPU list
# For Docker: use container name 'ollama-gpu'
# For local dev: use 'localhost:11434'
OLLAMA_GPU_URL=http://ollama-gpu:11434

# Ollama CPU server URL (for CPU-routed models)
# This is used for models listed in model-routing.json CPU array
# For Docker: use container name 'ollama-cpu'
# For local dev: use 'localhost:11435'
OLLAMA_CPU_URL=http://ollama-cpu:11434

# Note: Model routing is controlled by model-routing.json
# - Models in the "cpu" array use OLLAMA_CPU_URL
# - All other models use OLLAMA_GPU_URL (default)
# - See model-routing.example.json for configuration